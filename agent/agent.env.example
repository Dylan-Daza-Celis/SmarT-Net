# Copy to root .env.agent (ignored), not to a tracked file. No usable credentials.
SMARTIR_AGENT_USERNAME=
# Prefer an owner-only secret file when running independently.
SMARTIR_AGENT_PASSWORD_FILE=
# Alternative injected environment secret; never set both sources simultaneously.
SMARTIR_AGENT_PASSWORD=
SMARTIR_AGENT_API_URL=http://127.0.0.1:8000
SMARTIR_AGENT_SENSOR=suricata-agent
